# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dailydough?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:yourpassword@cluster0.mongodb.net/dailydough?retryWrites=true&w=majority

# Server Configuration
PORT=5001
NODE_ENV=development

# Optional Admin Credentials for Console Session Protection
ADMIN_USERNAME=admin
ADMIN_PIN=1234
